LLM_PROVIDER=nvidia  # Options: nvidia, openai, gemini, anthropic, ollama
NVIDIA_API_KEY=your_nvidia_nim_key_here
OPENAI_API_KEY=your_openai_key_here
GEMINI_API_KEY=your_google_gemini_key_here
ANTHROPIC_API_KEY=your_anthropic_key_here
# Comma-separated allowed frontend origins for CORS.
# `ALLOWED_ORIGINS` is the preferred name; `CORS_ORIGINS` is also supported for backward compatibility.
ALLOWED_ORIGINS=https://sys-aid.netlify.app,http://localhost:5173,http://127.0.0.1:5173
BACKEND_API_KEY=your_optional_api_key_here
PORT=8000
ENVIRONMENT=production

# Required — the app fails to boot without these two (see app/core/db.py,
# app/core/cache.py). asyncpg is the installed driver, so use +asyncpg here,
# not +psycopg.
DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/dbname
REDIS_URL=redis://localhost:6379

# Required for Google Sign-In (POST /auth/google) to work at all.
GOOGLE_CLIENT_ID=your_google_oauth_client_id
# Optional. How often (seconds) the background job sweeps expired sessions
# out of Postgres. Defaults to 6 hours.
SESSION_CLEANUP_INTERVAL_SECONDS=21600
# RAG loads a local ONNX embedding model (all-MiniLM-L6-v2) into memory on
# first use. Leave unset/false on memory-constrained hosts (e.g. Render's
# 512Mi free tier) to avoid OOM; set to true only if your plan has headroom.
RAG_ENABLED=false
