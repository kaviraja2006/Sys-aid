LLM_PROVIDER=nvidia  # Options: nvidia, openai, gemini, anthropic, ollama
NVIDIA_API_KEY=your_nvidia_nim_key_here
OPENAI_API_KEY=your_openai_key_here
GOOGLE_API_KEY=your_google_gemini_key_here
ANTHROPIC_API_KEY=your_anthropic_key_here
# Comma-separated allowed frontend origins for CORS.
# `ALLOWED_ORIGINS` is the preferred name; `CORS_ORIGINS` is also supported for backward compatibility.
ALLOWED_ORIGINS=https://sys-aid.netlify.app,http://localhost:5173,http://127.0.0.1:5173
BACKEND_API_KEY=your_optional_api_key_here
PORT=8000
ENVIRONMENT=production
